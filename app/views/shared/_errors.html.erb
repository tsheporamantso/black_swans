<% if @student.errors.any? %>
  <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mb-6">
    <h4 class="mb-5">
      The following <%= pluralize(@student.errors.count, "error") %> prevented the
      <%= @student.class.name.downcase %>
      from being saved.
    </h4>
    <ul class="list-disc ml-6 mb-5">
      <% @student.errors.full_messages.each do |message| %>
        <li class="text-red-500"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
