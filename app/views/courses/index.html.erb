<!-- Pagination -->
<div class="mb-20">
  <%= render "pagination" %>
</div>

<!-- Page heading -->
<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-800">Courses</h1>
    <p class="text-sm text-gray-500 mt-1">Manage and view all courses.</p>
  </div>
  <%=
    link_to "Create New Course", new_course_path,
    class: "text-center rounded-lg px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium transition shadow-sm"
  %>
</div>
<!-- Course list -->
<% if @courses.any? %>
  <% @courses.each do |course| %>
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 hover:shadow-lg transition mb-8">
      <div class="flex flex-col gap-x-10 gap-y-4 text-gray-700">
        <div>
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Course</p>
          <p class="mt-1 font-medium">
            <%= course.name %>
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</p>
          <p class="mt-1 font-medium">
            <%= course.description %>
          </p>
        </div>
        <!-- Action buttons -->
        <div class="border-t border-gray-200 mt-6 pt-5 flex flex-col sm:flex-row gap-3">
          <%=
            link_to "View Course", course,
            class: "text-center rounded-lg px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium transition"
          %>
          <%=
            link_to "Edit Course", edit_course_path(course),
            class: "text-center rounded-lg px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium transition"
          %>
          <%= button_to "Delete Course", course, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this course?" }, class: "rounded-lg px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer transition" %>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="bg-white rounded-xl shadow-md border border-gray-200 p-10 text-center">
    <h2 class="text-xl font-semibold text-gray-700">No courses found</h2>
    <p class="text-gray-500 mt-2">Start by registering your first course.</p>
    <%=
      link_to "Create New Course", new_courses_path,
      class: "inline-block mt-5 rounded-lg px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium transition"
    %>
  </div>
<% end %>
<!-- Pagination -->
<div class="mt-20">
  <%= render "pagination" %>
</div>
