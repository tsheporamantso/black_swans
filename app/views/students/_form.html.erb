<%= form_with model: student do |form| %>

  <%= render "shared/errors" %>

  <div class="flex flex-col gap-2 justify-center align-center w-2xl "> 
    <%= form.label :first_name, class: "capitalize font-medium text-lg"%> 
    <%= form.text_field :first_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": student.errors[:first_name].none?, "border-red-400 focus:outline-red-600": student.errors[:first_name].any?}]%>
  
    <%= form.label :last_name, class: "capitalize font-medium text-lg" %>
    <%= form.text_field :last_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": student.errors[:last_name].none?, "border-red-400 focus:outline-red-600": student.errors[:last_name].any?}] %>
  
    <%= form.label :email, class: "capitalize font-medium text-lg" %>
    <%= form.email_field :email, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": student.errors[:email].none?, "border-red-400 focus:outline-red-600": student.errors[:email].any?}] %>

    <%= form.label :address, class: "capitalize font-medium text-lg" %>
    <%= form.text_field :permanent_address, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": student.errors[:permanent_address].none?, "border-red-400 focus:outline-red-600": student.errors[:permanent_address].any?}] %>
  
  <%= form.submit class: "text-white bg-blue-500 hover:bg-blue-700 py-2 px-2 rounded-md mt-3 text-lg" %>
  </div>
<% end %>