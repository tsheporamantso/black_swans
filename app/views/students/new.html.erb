<h1 class="text-lg font-bold">New Student</h1>

<%= form_with model: @student do |form| %>
<div class="flex flex-col gap-3">
    <div>
      <%= form.label :first_name %> 
      <%= form.text_field :first_name, class: "border border-gray-400 rounded-md" %>
    </div>
    <div>
      <%= form.label :last_name %>
      <%= form.text_field :last_name, class: "border border-gray-400 rounded-md" %>
    </div>
    <div>
      <%= form.label :email %>
      <%= form.email_field :email, class: "border border-gray-400 rounded-md" %>
    </div>
    <div>
      <%= form.label :date_of_birth %>
      <%= form.date_field :date_of_birth, class: "border border-gray-400 rounded-md" %>
    </div>
    <div>
      <%= form.label :address %>
      <%= form.text_field :permanent_address, class: "border border-gray-400 rounded-md" %>
    </div>

    <%= form.submit class: "text-white bg-blue-500 hover:bg-blue-700 py-1 px-2 rounded-md mt-3 text-md" %>
</div>
<% end %>