<h1 class="text-lg font-bold">Students List</h1>

  <div class="grid grid-cols-8 font-bold capitalize py-2 "> 
    <p>first name</p>
    <p>last name</p>   
    <p>email</p>   
    <p>date of birth</p>   
    <p>address</p> 
    <p class="col-span-3">Actions</p>  
  </div>

<% @students.each do |student| %>
  <div class="grid grid-cols-8 py-1">
    <p><%= student.first_name %></p>
    <p><%= student.last_name %></p>
    <p><%= student.email %></p>
    <p><%= student.date_of_birth %></p>
    <p><%= student.permanent_address %></p>

    <div class="col-span-3 flex gap-3">
      <%= link_to "View", student %>
      <%= link_to "Edit", edit_student_path(student) %>
      <%= button_to "Delete", student, method: :delete, data: {
        turbo_confirm: "Are you sure?"
      }%>
    </div>
  </div>
<% end %>

<%= link_to "home", root_path, class: "py-1 capitalize text-white bg-blue-500 text-lg text-center mt-2 rounded-md " %>