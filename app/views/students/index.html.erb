<h1 class="text-3xl font-bold">Students List</h1>

  <div class="grid grid-cols-8 font-medium text-lg capitalize py-2 gap-8"> 
    <p>first name</p>
    <p>last name</p>   
    <p>email</p>   
    <p>address</p> 
    <p class="col-span-3">Actions</p>  
  </div>

<% @students.each do |student| %>
  <div class="grid grid-cols-8 gap-8 py-3 text-md">
    <p><%= student.first_name %></p>
    <p><%= student.last_name %></p>
    <p><%= student.email %></p>
    <p><%= student.permanent_address %></p>

    <div class="col-span-3 flex gap-3">
      <%= link_to "View", student %>
      <%= link_to "Edit", edit_student_path(student) %>
      <%= button_to "Delete", student, method: :delete, data: {
        turbo_confirm: "Are you sure?"
      }, class: "cursor-pointer"%>
    </div>
  </div>
<% end %>
<div class="mt-5">
  <%= link_to "Create New Student", new_student_path, class: "py-1 px-2 capitalize text-white bg-blue-500 text-lg text-center rounded-md " %>
</div>