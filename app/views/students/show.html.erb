<div class="max-w-4xl mx-auto">
  <h1 class="text-3xl font-bold mb-6 text-gray-800">Student Details</h1>

  <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-6 sm:p-8">
    <!-- Profile Header -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-6 pb-8 border-b border-gray-200">
      <% if @student.profile_image.attached? %>
        <%=
          image_tag @student.profile_image,
          alt: "#{@student.full_name}'s profile image",
          class: "w-28 h-28 rounded-2xl object-cover object-center border border-gray-200 shadow-md shrink-0"
        %>
      <% else %>
        <div
          class="w-28 h-28 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-3xl font-bold shrink-0"
        >
          <%= @student.first_name.first.upcase %><%= @student.last_name.first.upcase %>
        </div>
      <% end %>

      <div class="text-center sm:text-left pt-2">
        <h2 class="text-2xl font-bold text-gray-800">
          <%= @student.full_name %>
        </h2>

        <p class="text-gray-500 mt-2">
          <%= @student.email.downcase %>
        </p>

        <p class="text-sm text-indigo-600 font-medium mt-3">Student Profile</p>
      </div>
    </div>

    <!-- Student Information -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-7 pt-8 text-gray-700">
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Date of Birth</p>
        <p class="text-base mt-2">
          <%= formatted_date(@student.date_of_birth) %>
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Student Age</p>
        <p class="text-base mt-2">
          <%= @age %>
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Permanent Address</p>
        <p class="text-base mt-2">
          <%= @student.permanent_address %>
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Local Address</p>
        <p class="text-base mt-2">
          <%= @student.local_address %>
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Permanent Contact Number</p>
        <p class="text-base mt-2">
          <%= @student.permanent_contact_number %>
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Alternative Contact Number</p>
        <p class="text-base mt-2">
          <%= @student.alternative_contact_number %>
        </p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="border-t border-gray-200 mt-8 pt-6 flex flex-col sm:flex-row gap-3">
      <%=
        link_to "Edit Student", edit_student_path(@student),
        class: "text-center rounded-lg px-5 py-2.5 bg-indigo-600 text-white hover:bg-indigo-500 font-medium transition"
      %>

      <%=
        link_to "Back to Students", students_path,
        class: "text-center rounded-lg px-5 py-2.5 bg-gray-100 text-gray-700 hover:bg-gray-200 font-medium transition"
      %>

      <%=
        button_to "Delete Student", @student,
        method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this student?" },
        class: "rounded-lg px-5 py-2.5 bg-red-600 text-white hover:bg-red-500 font-medium cursor-pointer transition"
      %>
    </div>
  </div>
</div>
