<h1 class="text-4xl font-bold mb-3">Student Details</h1>

<div class="flex flex-col gap-3 text-lg">
  <p><strong>Full Name:</strong> <%= @student.full_name %></p>
  <p><strong>Student Age:</strong> <%= @student.student_age %></p>
  <p><strong>Email:</strong> <%= @student.email.downcase %></p>
  <p><strong>Permanent Address:</strong> <%= @student.permanent_address %></p>
  <p><strong>Local Address:</strong> <%= @student.local_address %></p>
  <p><strong>Permanent Contact Number:</strong> <%= @student.permanent_contact_number %></p>
  <p><strong>Alt Contact Number:</strong> <%= @student.alternative_contact_number %></p>
</div>

<div class="mt-4 flex gap-4">
  <%= link_to "Edit this student", edit_student_path(@student), class:"w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to students", students_path, class:"w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this student", @student, method: :delete, data: {
    turbo_confirm: "Are you sure?"
  }, class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer" %>
</div>