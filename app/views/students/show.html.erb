
<div class="max-w-4xl mx-auto">

  <h1 class="text-3xl font-bold mb-6 text-gray-800">
    Student Details
  </h1>

  <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-6 sm:p-8">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 text-gray-700">

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Full Name</p>
        <p class="text-lg font-medium mt-1"><%= @student.full_name %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date of Birth</p>
        <p class="text-lg mt-1"><%= formatted_date(@student.date_of_birth) %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Student Age</p>
        <p class="text-lg mt-1"><%= @age %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Email Address</p>
        <p class="text-lg mt-1 break-all"><%= @student.email.downcase %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Permanent Address</p>
        <p class="text-lg mt-1"><%= @student.permanent_address %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Local Address</p>
        <p class="text-lg mt-1"><%= @student.local_address %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Permanent Contact Number</p>
        <p class="text-lg mt-1"><%= @student.permanent_contact_number %></p>
      </div>

      <div>
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Alternative Contact Number</p>
        <p class="text-lg mt-1"><%= @student.alternative_contact_number %></p>
      </div>

    </div>

    <div class="border-t border-gray-200 mt-8 pt-6 flex flex-col sm:flex-row gap-3">

      <%= link_to "Edit Student", edit_student_path(@student),
          class: "text-center rounded-lg px-5 py-2.5 bg-indigo-600 text-white hover:bg-indigo-500 font-medium transition" %>

      <%= link_to "Back to Students", students_path,
          class: "text-center rounded-lg px-5 py-2.5 bg-gray-100 text-gray-700 hover:bg-gray-200 font-medium transition" %>

      <%= button_to "Delete Student", @student,
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this student?" },
          class: "rounded-lg px-5 py-2.5 bg-red-600 text-white hover:bg-red-500 font-medium cursor-pointer transition" %>

    </div>

  </div>
</div>
